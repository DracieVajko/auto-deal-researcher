root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf

[*.sh]
end_of_line = lf

[*.ps1]
end_of_line = lf

[*.py]
end_of_line = lf

[*.md]
end_of_line = lf
trim_trailing_whitespace = false
