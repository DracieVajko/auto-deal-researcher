# Auto Deal Searcher — example secrets file
#
# Usage:
#   cp .env.example .env      (Windows: copy .env.example .env)
#   then fill in your own values. .env is git-ignored — never commit it.
#
# Load order: real environment variables win; .env only fills in what is missing.
# config.yaml references these with ${VAR} / ${VAR:-default} placeholders.

# --- Local inference (LM Studio / Ollama / llama.cpp) ---------------------
# Leave empty to keep the config.yaml value (http://localhost:1234).
LMSTUDIO_ENDPOINT=

# --- LLM fallbacks (all optional; used only when local models fail) --------
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- eBay Browse API (replaces the discontinued HTML scraper) -------------
# Create an app at https://developer.ebay.com/ — the keys come from the
# "Production Keys" / auth token page. Sandbox defaults to sandbox.ebay.com.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_RU_NAME=
EBAY_SANDBOX=1