# Auto Deal Searcher — example secrets file
#
# Usage:
#   cp .env.example .env      (Windows: copy .env.example .env)
#   then fill in your own values. .env is git-ignored — never commit it.
#
# Load order: real environment variables win; .env only fills in what is missing.
# config.yaml references these with ${VAR} / ${VAR:-default} placeholders.

# --- Local inference (LM Studio / Ollama / llama.cpp) ---------------------
# Leave empty to keep the config.yaml value (http://localhost:1234).
LMSTUDIO_ENDPOINT=

# --- LLM fallbacks (all optional; used only when local models fail) --------
# These providers are the fallback chain used by the searcher and the
# Diamond Search agents. Small models are enough: they only produce short
# search queries and KEEP/DISCARD verdicts.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# --- Tuning (optional) ----------------------------------------------------
# Gemini thinking models spend output tokens on reasoning before any answer.
ADS_GEMINI_MIN_OUTPUT_TOKENS=512