{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest (unit only)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "pytest (live sites, headless)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_live_sites.py", "-m", "live", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "pytest (live sites, headed)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_live_sites.py", "-m", "live", "--headed", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "pytest (live: one site)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_live_sites.py", "-m", "live", "--site", "alza", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    }
  ]
}